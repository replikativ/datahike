;; usage: bb benchmark/storage_amp_report.bb <AMP_OUT_DIR>  -> markdown table from summary.csv + per-run CSVs
;; (the double-counted set below applies only to the 2026-11-09 runs made before the cycle-count fix)
(require '[clojure.string :as str] '[clojure.java.io :as io])
(def out-dir (first *command-line-args*))
(defn rows [f] (let [[h & rs] (map #(str/split % #"," -1) (str/split-lines (slurp f)))]
                 [(mapv keyword h) rs]))
(defn n [s] (try (Double/parseDouble s) (catch Exception _ Double/NaN)))
(def double-counted #{"w1-def-g3x" "w1-def-g4wx" "w1-def-g2x" "w1-def-g4x" "w1-def-g3shared" "w1-kh0-g3x"})
(let [[h rs] (rows (io/file out-dir "summary.csv"))
      hi (zipmap h (range))
      g (fn [r k] (nth r (hi k) ""))]
  (println "| run | config | gc | commits/s | live MB | store MB end | steady store MB (last 1/3 mean) | peak store MB | files end | amp end | amp steady | growth KB/commit (last 1/3) | written KB/commit | bg cycles | bg swept | cycle s mean/max | online freed | after gc-all MB | after gc-now MB | integrity | history probe |")
  (println "|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|")
  (doseq [r rs]
    (if (= "REFUSED" (nth r 4 ""))
      (println (str "| " (nth r 0) " | " (nth r 2) " | " (nth r 3) " | REFUSED at connect: " (nth r 5) " |"))
      (let [label (g r :label)
            f (io/file out-dir (str label ".csv"))
            [ch crs] (rows f)
            ci (zipmap ch (range))
            c (fn [x k] (n (nth x (ci k))))
            load (filter #(= "load" (nth % (ci :phase))) crs)
            k (max 2 (quot (count load) 3))
            tail (take-last k load)
            mean-store (/ (reduce + (map #(c % :store_bytes) tail)) (count tail))
            mean-live (/ (reduce + (map #(c % :live_bytes) tail)) (count tail))
            peak (apply max (map #(c % :store_bytes) load))
            a (first tail) z (last tail)
            slope (/ (- (c z :store_bytes) (c a :store_bytes)) (max 1 (- (c z :commit) (c a :commit))))
            dc (if (double-counted label) 2 1)
            probe (if (> (count r) (count h)) (nth r (inc (hi :integrity))) "")]
        (println (str "| " (str/join " | "
                  [label (g r :config) (g r :gc)
                   (format "%.1f" (n (g r :load_commits_per_s)))
                   (format "%.1f" (n (g r :live_mb_end)))
                   (format "%.1f" (n (g r :store_mb_end)))
                   (format "%.1f" (/ mean-store 1e6))
                   (format "%.1f" (/ peak 1e6))
                   (g r :files_end)
                   (format "%.2f" (n (g r :amp_end)))
                   (format "%.2f" (/ mean-store mean-live))
                   (format "%.1f" (/ slope 1e3))
                   (format "%.1f" (/ (n (g r :written_b_per_commit)) 1e3))
                   (str (long (/ (n (g r :run_gc_cycles)) dc)))
                   (str (long (/ (n (g r :run_gc_swept)) dc)))
                   (format "%.0f/%.0f" (/ (n (g r :run_gc_ms_mean)) 1e3) (/ (n (g r :run_gc_ms_max)) 1e3))
                   (g r :ogc_collected)
                   (format "%.1f" (n (g r :store_mb_after_gc_all)))
                   (format "%.1f" (n (g r :store_mb_after_gc_now)))
                   (g r :integrity) probe]) " |"))))))
