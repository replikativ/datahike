;; Run matrix for benchmark.storage-amp. Each key is one JVM batch:
;;   clj -J-Xmx3g -M:bench -m benchmark.storage-amp :w1-a
;; Env: AMP_STORE_ROOT (store dirs, on a real disk), AMP_OUT_DIR (CSVs).
{
 :w1-a
 [{:label "w1-def-g0" :workload :w1 :gc :g0 :wl {:seed-entities 40000 :commits 3000 :sample-every 250}}
  {:label "w1-def-g1" :workload :w1 :gc :g1 :wl {:seed-entities 40000 :commits 3000 :sample-every 250}}
  {:label "w1-def-g3x" :workload :w1 :gc :g3 :config {:exclusive? true} :gc-opts {:interval-ms 15000 :history-window-ms 60000} :wl {:seed-entities 40000 :commits 3000 :sample-every 250}}
  {:label "w1-def-g4wx" :workload :w1 :gc :g4w :config {:exclusive? true} :gc-opts {:interval-ms 15000 :history-window-ms 60000} :wl {:seed-entities 40000 :commits 3000 :sample-every 250}}]

 :w1-b
 [{:label "w1-def-g2x" :workload :w1 :gc :g2 :config {:exclusive? true} :gc-opts {:interval-ms 15000 :history-window-ms 60000} :wl {:seed-entities 40000 :commits 3000 :sample-every 250}}
  {:label "w1-def-g4x" :workload :w1 :gc :g4 :config {:exclusive? true} :gc-opts {:interval-ms 15000 :history-window-ms 60000} :wl {:seed-entities 40000 :commits 3000 :sample-every 250}}
  {:label "w1-def-g3shared" :workload :w1 :gc :g3 :config {} :gc-opts {:interval-ms 15000 :history-window-ms 60000} :wl {:seed-entities 40000 :commits 3000 :sample-every 250}}]

 :w1-c
 [{:label "w1-kh0-g0" :workload :w1 :gc :g0 :config {:keep-history? false} :wl {:seed-entities 40000 :commits 3000 :sample-every 250}}
  {:label "w1-kh0-g1" :workload :w1 :gc :g1 :config {:keep-history? false} :wl {:seed-entities 40000 :commits 3000 :sample-every 250}}
  {:label "w1-kh0-g3x" :workload :w1 :gc :g3 :config {:keep-history? false :exclusive? true} :gc-opts {:interval-ms 15000 :history-window-ms 60000} :wl {:seed-entities 40000 :commits 3000 :sample-every 250}}
  {:label "w1-kh0nocg-g0" :workload :w1 :gc :g0 :config {:keep-history? false :commit-graph? false} :wl {:seed-entities 40000 :commits 3000 :sample-every 250}}
  {:label "w1-kh0nocg-g1" :workload :w1 :gc :g1 :config {:keep-history? false :commit-graph? false} :wl {:seed-entities 40000 :commits 3000 :sample-every 250}}]

 :w1-d
 [{:label "w1-ch1-g0" :workload :w1 :gc :g0 :config {:crypto-hash? true} :wl {:seed-entities 40000 :commits 3000 :sample-every 250}}
  {:label "w1-ch1-g1" :workload :w1 :gc :g1 :config {:crypto-hash? true} :wl {:seed-entities 40000 :commits 3000 :sample-every 250}}
  {:label "w1-fuse-g0" :workload :w1 :gc :g0 :config {:fuse? true} :wl {:seed-entities 40000 :commits 3000 :sample-every 250}}
  {:label "w1-fuse-g1" :workload :w1 :gc :g1 :config {:fuse? true} :wl {:seed-entities 40000 :commits 3000 :sample-every 250}}
  {:label "w1-db128-g1" :workload :w1 :gc :g1 :config {:diff-buf 128} :wl {:seed-entities 40000 :commits 3000 :sample-every 250}}
  {:label "w1-db128-g0" :workload :w1 :gc :g0 :config {:diff-buf 128} :wl {:seed-entities 40000 :commits 3000 :sample-every 250}}
  {:label "w1-db128-g3x" :workload :w1 :gc :g3 :config {:diff-buf 128 :exclusive? true} :gc-opts {:interval-ms 15000 :history-window-ms 60000} :wl {:seed-entities 40000 :commits 3000 :sample-every 250}}]

 :w3-a
 [{:label "w3-def-g0" :workload :w3 :gc :g0 :wl {:seed-entities 0 :commits 300 :sample-every 10}}
  {:label "w3-def-g1" :workload :w3 :gc :g1 :wl {:seed-entities 0 :commits 300 :sample-every 10}}
  {:label "w3-def-g3x" :workload :w3 :gc :g3 :config {:exclusive? true} :gc-opts {:interval-ms 15000 :history-window-ms 60000} :wl {:seed-entities 0 :commits 300 :sample-every 10}}]

 :w3-b
 [{:label "w3-kh0-g0" :workload :w3 :gc :g0 :config {:keep-history? false} :wl {:seed-entities 0 :commits 300 :sample-every 10}}
  {:label "w3-kh0-g1" :workload :w3 :gc :g1 :config {:keep-history? false} :wl {:seed-entities 0 :commits 300 :sample-every 10}}]

 :w2-a
 [{:label "w2-def-g0" :workload :w2 :gc :g0 :wl {:seed-entities 360000 :commits 120 :sample-every 10}}
  {:label "w2-def-g1" :workload :w2 :gc :g1 :wl {:seed-entities 360000 :commits 120 :sample-every 10}}]

 :w2-b
 [{:label "w2-def-g3x" :workload :w2 :gc :g3 :config {:exclusive? true} :gc-opts {:interval-ms 15000 :history-window-ms 60000} :wl {:seed-entities 360000 :commits 120 :sample-every 10}}
  {:label "w2-kh0-g0" :workload :w2 :gc :g0 :config {:keep-history? false} :wl {:seed-entities 360000 :commits 120 :sample-every 10}}]


 :w1-e
 [{:label "w1-ch1-g1-r2" :workload :w1 :gc :g1 :config {:crypto-hash? true} :wl {:seed-entities 40000 :commits 3000 :sample-every 250}}
  {:label "w1-def-g1-r2" :workload :w1 :gc :g1 :wl {:seed-entities 40000 :commits 3000 :sample-every 250}}
  {:label "w1-def-g0-r2" :workload :w1 :gc :g0 :wl {:seed-entities 40000 :commits 3000 :sample-every 250}}
  {:label "w1-kh0-g3x-r2" :workload :w1 :gc :g3 :config {:keep-history? false :exclusive? true} :gc-opts {:interval-ms 15000 :history-window-ms 60000} :wl {:seed-entities 40000 :commits 3000 :sample-every 250}}
  {:label "w1-def-g3x-r2" :workload :w1 :gc :g3 :config {:exclusive? true} :gc-opts {:interval-ms 15000 :history-window-ms 60000} :wl {:seed-entities 40000 :commits 3000 :sample-every 250}}]
}
